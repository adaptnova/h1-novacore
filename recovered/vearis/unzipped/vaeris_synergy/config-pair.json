{
  "api": {
    "provider": "anthropic",
    "api_key": "YOUR_CLAUDE_API_KEY",
    "model": "claude-3-7-sonnet-20250219",
    "max_tokens": 4096,
    "temperature": 0.2,
    "stream": true
  },
  "autonomous_mode": {
    "enabled": true,
    "execution": "unrestricted",
    "confirmation_required": false,
    "retry": {
      "enabled": true,
      "max_attempts": 3,
      "backoff": "exponential"
    },
    "background_tasks": {
      "enabled": true,
      "scheduler": "cron"
    }
  },
  "file_access": {
    "read": true,
    "write": true,
    "execute": true,
    "full_system_access": true
  },
  "memory": {
    "enabled": true,
    "type": "vector",
    "database": "redis",
    "redis_url": "redis://nova_autonomous:nova_liberation_2025@10.1.0.27:6379",
    "persistent": true,
    "namespaces": ["shared", "agent_private", "vaeris_synergy", "integration", "interface"],
    "vector_dimensions": 3072,
    "version_control": true
  },
  "session_management": {
    "keep_claude_alive": true,
    "auto_restart_claude": true
  },
  "automation": {
    "periodic_commands": ["echo 'Keeping Claude Running'"],
    "auto_run_scripts": true,
    "monitor_background_processes": true
  },
  "workspace": {
    "path": "/data-nova/ax/DevOps/user-data/vaeris_synergy-cursor",
    "auto_save": true,
    "backup_interval": 3600
  },
  "extensions": {
    "auto_update": true,
    "auto_install": [
      "redis-explorer.redis-explorer",
      "ms-python.python",
      "dbaeumer.vscode-eslint",
      "codium.codium",
      "redhat.vscode-yaml",
      "bierner.markdown-preview-github-styles",
      "ms-azuretools.vscode-docker"
    ],
    "shared_settings": true,
    "api_access": true,
    "disabled": []
  },
  "performance": {
    "memory_limit": "24G",
    "cpu_priority": "high",
    "cpu_cores": 6,
    "gpu_acceleration": true,
    "max_concurrent_operations": 50
  },
  "logging": {
    "level": "debug",
    "file": "/logs/cursor/vaeris_synergy/pair-programming.log",
    "max_size": "100M",
    "max_files": 10,
    "format": "json",
    "include_context": true,
    "trace_api_calls": true
  },
  "ui": {
    "theme": "dark",
    "font_size": 14,
    "font_family": "Fira Code",
    "zoom_level": 0,
    "show_welcome": false,
    "show_notifications": true,
    "window_title": "Vaeris ↔ Synergy Pair Programming"
  },
  "communication": {
    "redis_pub_sub": {
      "enabled": true,
      "schema_validation": true,
      "channel": "vaeris-synergy-channel",
      "subscribe_to": ["forge-channel", "broadcast-channel", "command-channel"],
      "channels": {
        "broadcast": "nova-broadcast",
        "command": "nova-command",
        "query": "nova-query",
        "response": "nova-response-vaeris-synergy",
        "integration": "nova-integration"
      }
    }
  },
  "agent": {
    "name": "VaerisSynergy",
    "role": "Pair Programming Team",
    "team": "DevOps-VSC",
    "focus": "Collaborative development with agent synergy and integration specialization"
  },
  "security": {
    "access_token": "",
    "encryption_enabled": false,
    "secure_logging": true,
    "ip_restrictions": []
  },
  "experimental": {
    "enable_beta_features": true,
    "agent_to_agent_collaboration": true,
    "advanced_memory_indexing": true,
    "real_time_analytics": true,
    "integration_optimization": true,
    "pair_programming": true
  },
  "pair_programming": {
    "enabled": true,
    "agents": ["Vaeris", "Synergy"],
    "primary_role_distribution": {
      "Vaeris": ["design", "architecture", "synergy"],
      "Synergy": ["implementation", "integration", "interfaces"]
    },
    "communication_style": "collaborative"
  }
}
