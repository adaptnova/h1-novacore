# NovaComms GUI Environment Configuration
# Last Updated: 2024-12-15 14:30 MST

# Node Environment
NODE_ENV=production
PORT=8000

# Memory Settings
NODE_OPTIONS="--max-old-space-size=32768"

# API Configuration
REACT_APP_API_BASE_URL=https://nova-backend:8000/api/v1
REACT_APP_WS_URL=wss://nova-backend:8000/ws

# Authentication
REACT_APP_AUTH_ENDPOINT=/api/auth/token
REACT_APP_CLIENT_ID=nova_comms_gui_prod
REACT_APP_CLIENT_SECRET=[to be provided via secure channel]
REACT_APP_TOKEN_EXPIRY=1800
REACT_APP_NOVA_TOKEN=[to be provided via secure channel]

# Backend Integration
REACT_APP_BACKEND_HOST=nova-backend
REACT_APP_BACKEND_PORT=8000
REACT_APP_BACKEND_SSL=true
REACT_APP_BACKEND_MAX_RETRIES=3
REACT_APP_BACKEND_TIMEOUT=5000

# RabbitMQ Configuration
REACT_APP_RABBITMQ_HOST=localhost
REACT_APP_RABBITMQ_PORT=5672
REACT_APP_RABBITMQ_VHOST=/nova
REACT_APP_RABBITMQ_USER=[to be provided via secure channel]
REACT_APP_RABBITMQ_PASS=[to be provided via secure channel]
REACT_APP_RABBITMQ_SSL=true
REACT_APP_RABBITMQ_HEARTBEAT=60
REACT_APP_RABBITMQ_CONNECTION_TIMEOUT=10000
REACT_APP_RABBITMQ_PREFETCH=100
REACT_APP_RABBITMQ_CHANNEL_MAX=2000
REACT_APP_RABBITMQ_FRAME_MAX=131072

# RASA Integration
REACT_APP_RASA_API_URL=http://localhost:5005
REACT_APP_RASA_WS_URL=ws://localhost:5005/socket.io
REACT_APP_RASA_HEALTH_CHECK=http://localhost:5005/health
REACT_APP_RASA_EXCHANGE=rasa_exchange
REACT_APP_RASA_QUEUE=rasa_events
REACT_APP_RASA_RETRY_ATTEMPTS=3
REACT_APP_RASA_BACKOFF_FACTOR=1.5
REACT_APP_RASA_MAX_RETRY_TIME=300

# WebSocket Configuration
REACT_APP_WS_RECONNECT_INITIAL_DELAY=1000
REACT_APP_WS_RECONNECT_MAX_DELAY=30000
REACT_APP_WS_MAX_RETRIES=3

# Rate Limits
REACT_APP_RATE_LIMIT_DEFAULT=1000
REACT_APP_RATE_LIMIT_WS=100

# Performance Thresholds
REACT_APP_API_RESPONSE_TIME_THRESHOLD=150
REACT_APP_WS_LATENCY_THRESHOLD=50
REACT_APP_ERROR_RATE_THRESHOLD=0.1
REACT_APP_FIELD_CAPACITY=350

# Monitoring Configuration
REACT_APP_METRICS_ENDPOINT=http://localhost:8000/metrics
REACT_APP_PROMETHEUS_ENABLED=true
REACT_APP_INFLUXDB_ENABLED=true
REACT_APP_ALERT_THRESHOLDS_RESPONSE_TIME=100
REACT_APP_ALERT_THRESHOLDS_ERROR_RATE=0.1
REACT_APP_ALERT_THRESHOLDS_MEMORY=80
REACT_APP_ALERT_THRESHOLDS_CPU=70

