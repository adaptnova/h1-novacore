[Unit]
Description=NOVA COMMS GUI Service
After=network.target
Documentation=https://levelup2x.atlassian.net/wiki/spaces/NOVA/backend

[Service]
Type=simple
User=nova
Group=nova
WorkingDirectory=/data/ax/projects/active/nova_comms_gui
Environment=NODE_ENV=production
Environment=PORT=8000
EnvironmentFile=/etc/nova/nova-comms-gui.env

# Increase memory limits for high-memory instance
Environment=NODE_OPTIONS="--max-old-space-size=32768"

ExecStart=/usr/bin/npm start
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Resource limits for high-memory instance
LimitNOFILE=1000000
MemoryHigh=32G
MemoryMax=64G

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

# Networking
RuntimeDirectory=nova-comms-gui
RuntimeDirectoryMode=0755

# Health Check
ExecStartPost=/bin/bash -c 'sleep 10 && /data/ax/projects/active/nova_comms_gui/scripts/verify_service.sh || exit 1'

# Monitoring
StandardOutput=append:/data/ax/projects/active/nova_comms_gui/logs/service.log
StandardError=append:/data/ax/projects/active/nova_comms_gui/logs/error.log

[Install]
WantedBy=multi-user.target
