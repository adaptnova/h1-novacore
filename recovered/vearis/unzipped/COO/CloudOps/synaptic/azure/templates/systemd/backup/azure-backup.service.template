[Unit]
Description=Azure Data Backup Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# REPLACE: Update path to your backup script
ExecStart=/path/to/backup_script.sh
# REPLACE: Update with appropriate user/group
User=SERVICE_USER
Group=SERVICE_GROUP
# REPLACE: Update working directory
WorkingDirectory=/path/to/working/directory
# REPLACE: Update log paths
StandardOutput=append:/logs/backup/service-output.log
StandardError=append:/logs/backup/service-error.log

# Security settings
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target