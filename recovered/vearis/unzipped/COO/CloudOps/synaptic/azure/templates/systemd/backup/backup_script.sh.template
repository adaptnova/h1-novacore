#!/bin/bash

# Azure Data Backup Script Template
# Created: 2025-01-22
# Purpose: Template for incremental backup to Azure Blob Storage

# Strict error handling
set -euo pipefail
trap 'echo "Error on line $LINENO"' ERR

# Configuration - REPLACE these values
SOURCE_DIR="/path/to/source"
BACKUP_CONTAINER="your-container-name"
STORAGE_ACCOUNT="your-storage-account"
LOG_DIR="/logs/backup"
DATE=$(date +%Y%m%d_%H%M%S)
LOG_FILE="${LOG_DIR}/backup_${DATE}.log"

# Create log directory if it doesn't exist
mkdir -p "${LOG_DIR}"

# Log function with timestamps
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "${LOG_FILE}"
}

# Error handling function
handle_error() {
    local exit_code=$?
    log "ERROR: Command failed on line $1 with exit code $exit_code"
    # Add your error notification logic here (e.g., send email, Slack message)
    exit $exit_code
}

# Set up error trap
trap 'handle_error $LINENO' ERR

# Check dependencies
check_dependencies() {
    local deps=("azcopy" "az")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            log "ERROR: Required dependency '$dep' is not installed"
            exit 1
        fi
    done
}

# Initialize backup
init_backup() {
    log "Starting backup of ${SOURCE_DIR}"
    log "Destination: ${STORAGE_ACCOUNT}/${BACKUP_CONTAINER}"
}

# Get SAS token
get_sas_token() {
    log "Generating SAS token"
    local sas_token
    sas_token=$(az storage container generate-sas \
        --account-name "${STORAGE_ACCOUNT}" \
        --name "${BACKUP_CONTAINER}" \
        --permissions acdlrw \
        --expiry "$(date -u -d '1 hour' '+%Y-%m-%dT%H:%MZ')" \
        --auth-mode login \
        --as-user \
        --output tsv)

    if [ -z "${sas_token}" ]; then
        log "ERROR: Failed to generate SAS token"
        exit 1
    fi
    echo "${sas_token}"
}

# Perform backup
do_backup() {
    local sas_token=$1
    log "Starting azcopy sync operation"
    
    # CUSTOMIZE: Add or modify exclude patterns as needed
    azcopy sync "${SOURCE_DIR}" "https://${STORAGE_ACCOUNT}.blob.core.windows.net/${BACKUP_CONTAINER}?${sas_token}" \
        --recursive \
        --exclude-pattern="*/tmp/*;*/cache/*;*/proc/*;*/sys/*;*/dev/*" \
        --log-level=INFO \
        --output-type=text \
        --delete-destination=false \
        2>&1 | tee -a "${LOG_FILE}"

    return ${PIPESTATUS[0]}
}

# Cleanup old logs
cleanup_logs() {
    log "Cleaning up old logs"
    find "${LOG_DIR}" -type f -name "backup_*.log" -mtime +7 -delete
}

# Main execution
main() {
    check_dependencies
    init_backup
    local sas_token
    sas_token=$(get_sas_token)
    do_backup "${sas_token}"
    cleanup_logs
    log "Backup process completed successfully"
}

# Run main function
main

exit 0