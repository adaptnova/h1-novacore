# SSH Config for dataops-primary Server
# Created: 2025-03-22
# Author: Zorion (IBM Cloud Strategist & Provisioning Engineer)

# dataops-primary Server (root user)
Host dataops-primary-root
    HostName 
    User root
    IdentityFile /home/x/.ssh/ibm-admin_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

# dataops-primary Server (vertex user)
Host dataops-primary
    HostName 
    User vertex
    IdentityFile /home/x/.ssh/ibm-admin_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

# dataops-primary Server (x user)
Host dataops-primary-x
    HostName 
    User x
    IdentityFile /home/x/.ssh/ibm-admin_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
