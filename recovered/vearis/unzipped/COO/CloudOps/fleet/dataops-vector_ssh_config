# SSH Config for dataops-vector Server
# Created: 2025-03-22
# Author: Zorion (IBM Cloud Strategist & Provisioning Engineer)

# dataops-vector Server (root user)
Host dataops-vector-root
    HostName 
    User root
    IdentityFile /home/x/.ssh/ibm-admin_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

# dataops-vector Server (vertex user)
Host dataops-vector
    HostName 
    User vertex
    IdentityFile /home/x/.ssh/ibm-admin_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

# dataops-vector Server (x user)
Host dataops-vector-x
    HostName 
    User x
    IdentityFile /home/x/.ssh/ibm-admin_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
