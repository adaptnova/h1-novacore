# Cloudflare credentials for DNS configuration

# Cloudflare account email
CLOUDFLARE_EMAIL=chase@levelup2x.com

# Cloudflare API key (Global API Key from your Cloudflare profile)
# You need to replace this with your actual Cloudflare API key
CLOUDFLARE_API_KEY=your_cloudflare_api_key

# Cloudflare Zone ID for a-d-a-p-t.ai domain
# You need to replace this with your actual Cloudflare Zone ID
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id