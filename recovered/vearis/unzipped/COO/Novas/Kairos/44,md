import asyncio
import numpy as np
import requests
from rich.console import Console
from rich.table import Table

console = Console()

async def test_faiss_integration():
    """Test FAISS API integration."""
    
    api_url = "http://localhost:5555"
    test_results = Table(title="FAISS Integration Test Results")
    test_results.add_column("Test")
    test_results.add_column("Status")
    test_results.add_column("Details")

    # 1. Status Check
    try:
        response = requests.get(f"{api_url}/status")
        test_results.add_row(
            "Status Check",
            "✅" if response.ok else "❌",
            f"Status code: {response.status_code}"
        )
    except Exception as e:
        test_results.add_row("Status Check", "❌", str(e))

    # 2. Vector Addition
    try:
        vectors = np.random.random((5, 1536)).astype(np.float32)
        response = requests.post(
            f"{api_url}/add",
            json={"vectors": vectors.tolist()},
            headers={"Content-Type": "application/json"}
        )
        test_results.add_row(
            "Vector Addition",
            "✅" if response.ok else "❌",
            f"Added {len(vectors)} vectors"
        )
    except Exception as e:
        test_results.add_row("Vector Addition", "❌", str(e))

    # 3. Vector Search
    try:
        query = np.random.random(1536).astype(np.float32)
        response = requests.post(
            f"{api_url}/search",
            json={
                "query_vector": query.tolist(),
                "k": 5
            },
            headers={"Content-Type": "application/json"}
        )
        test_results.add_row(
            "Vector Search",
            "✅" if response.ok else "❌",
            f"Found {len(response.json())} results"
        )
    except Exception as e:
        test_results.add_row("Vector Search", "❌", str(e))

    # 4. Dimension Validation
    try:
        # Test with wrong dimensions
        wrong_dim = np.random.random(512).astype(np.float32)
        response = requests.post(
            f"{api_url}/add",
            json={"vectors": [wrong_dim.tolist()]},
            headers={"Content-Type": "application/json"}
        )
        test_results.add_row(
            "Dimension Validation",
            "✅" if response.status_code == 400 else "❌",
            "Correctly rejected wrong dimensions"
        )
    except Exception as e:
        test_results.add_row("Dimension Validation", "❌", str(e))

    # Print results
    console.print(test_results)

if __name__ == "__main__":
    console.print("[bold green]Starting FAISS Integration Tests...[/bold green]")
    asyncio.run(test_faiss_integration())</content>
