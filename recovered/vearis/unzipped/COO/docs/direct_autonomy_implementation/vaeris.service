[Unit]
Description=Nova COO - Vaeris
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=vaeris
Group=novas
WorkingDirectory=/opt/novas
ExecStart=/usr/bin/python3 /opt/novas/vaeris.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/nova/vaeris.log
StandardError=append:/var/log/nova/vaeris_err.log

# Environment variables
Environment="REDIS_HOST=localhost"
Environment="REDIS_PORT=6379"
Environment="REDIS_DB=0"
Environment="CONFIG_PATH=/opt/novas/config"
Environment="CLAUDE_API_KEY=your_api_key_here"
Environment="PYTHONPATH=/opt/novas"

# Security settings
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
NoNewPrivileges=true
ReadWritePaths=/opt/novas /var/log/nova

[Install]
WantedBy=multi-user.target