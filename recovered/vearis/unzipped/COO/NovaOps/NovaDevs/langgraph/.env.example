# System Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=UTC

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Database URLs
POSTGRES_URI=postgresql://user:password@localhost:5432/adapt
MONGODB_URI=mongodb://user:password@localhost:27017/adapt
NEO4J_URI=bolt://user:password@localhost:7687
REDIS_URL=redis://localhost:6379
ARANGO_URI=http://localhost:8529
CHROMA_URI=http://localhost:8000
MILVUS_URI=localhost:19530

# LLM API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
COHERE_API_KEY=your-cohere-api-key

# Integration API Keys
GITHUB_API_TOKEN=your-github-token
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_WEBHOOK_TeamADAPT=your-slack-webhook-url
SLACK_CHANNEL_TeamADAPT=your-slack-channel

# Atlassian Configuration
ATLASSIAN_URL=https://your-domain.atlassian.net
ATLASSIAN_USERNAME=your-atlassian-email
ATLASSIAN_API_TOKEN=your-atlassian-api-token
ATLASSIAN_PASSWORD=your-atlassian-password  # For browser access only

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your-grafana-api-key
LOKI_URL=http://localhost:3100

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elastic-password

# Vector Store Configuration
FAISS_INDEX_PATH=/path/to/faiss/indexes
ANNOY_INDEX_PATH=/path/to/annoy/indexes

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_PATH=/path/to/backups
BACKUP_RETENTION_DAYS=30

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
NOTIFICATION_EMAIL=notifications@yourdomain.com

# Documentation
DOCS_URL=http://localhost:8080
SWAGGER_URL=http://localhost:8000/docs

# Testing Configuration
TEST_DATABASE_URI=postgresql://test:test@localhost:5432/adapt_test
TEST_MONGODB_URI=mongodb://test:test@localhost:27017/adapt_test
TEST_NEO4J_URI=bolt://test:test@localhost:7687

# Feature Flags
FEATURE_AGENT_LEARNING=false
FEATURE_AUTO_SCALING=false
FEATURE_ADVANCED_SECURITY=false

# Performance Tuning
MAX_WORKERS=4
THREAD_POOL_SIZE=10
CONNECTION_POOL_SIZE=20
KEEP_ALIVE_TIMEOUT=5

# Logging Configuration
LOG_FORMAT=json
LOG_FILE_PATH=/path/to/logs
LOG_ROTATION=1d
LOG_RETENTION=30d

# Security Settings
SSL_ENABLED=true
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Agent Configuration
AGENT_TIMEOUT=30
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_DELAY=5
AGENT_MAX_CONCURRENT=10

# Memory Management
MEMORY_CACHE_SIZE=1000
MEMORY_TTL=3600
MEMORY_CLEANUP_INTERVAL=300

# Document Processing
MAX_DOCUMENT_SIZE=10485760  # 10MB
SUPPORTED_DOCUMENT_TYPES=pdf,docx,txt,html,csv,json
DOCUMENT_STORAGE_PATH=/path/to/documents

# LLM Configuration
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4
LLM_TIMEOUT=30
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7

# Knowledge Graph
GRAPH_DATABASE=neo4j
GRAPH_CACHE_ENABLED=true
GRAPH_CACHE_TTL=3600
GRAPH_BATCH_SIZE=1000

# API Integration
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3
API_RATE_LIMIT=100
API_CONCURRENT_LIMIT=10

# Workflow Configuration
WORKFLOW_ENGINE_ENABLED=true
WORKFLOW_STORAGE_PATH=/path/to/workflows
WORKFLOW_HISTORY_RETENTION=30d

# Metrics Collection
METRICS_ENABLED=true
METRICS_INTERVAL=60
METRICS_RETENTION=30d
METRICS_EXPORT_PATH=/path/to/metrics
