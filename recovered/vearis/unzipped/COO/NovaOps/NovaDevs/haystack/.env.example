# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_KEY=your-secure-api-key-here

# Vector Store Settings
CHROMA_PERSIST_DIR=data/chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Model Settings
READER_MODEL=deepset/roberta-base-squad2
MAX_SEQ_LENGTH=384
DOC_STRIDE=128
BATCH_SIZE=16

# Ray Distributed Settings
RAY_ADDRESS=auto
RAY_NUM_CPUS=1
RAY_NUM_GPUS=0

# Monitoring Settings
METRICS_PORT=9090
ENABLE_TRACING=false
TRACE_EXPORTER=otlp

# Cache Settings
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Security Settings
CORS_ORIGINS=*
RATE_LIMIT=100

# Logging Settings
LOG_LEVEL=INFO

# Note: Copy this file to .env and update the values for your environment
