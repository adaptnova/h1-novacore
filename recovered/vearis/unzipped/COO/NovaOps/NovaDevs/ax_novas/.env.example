# Environment Configuration
NOVA_ENVIRONMENT=development  # development, staging, production
NOVA_DEBUG=true
NOVA_LOG_LEVEL=DEBUG

# Security
NOVA_SECRET_KEY=your-secret-key-here
NOVA_ALLOWED_ORIGINS=http://localhost:*

# AI Providers
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Vector Store
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_ENVIRONMENT=your-environment
PINECONE_INDEX=nova-dev

# Database
NOVA_DATABASE_URL=sqlite:///data/nova_dev.db
NOVA_REDIS_URL=redis://localhost:6379/0

# Monitoring
NOVA_TELEMETRY_ENABLED=true
NOVA_METRICS_PORT=9090
NOVA_TRACING_SAMPLE_RATE=1.0

# System
NOVA_MAX_WORKERS=4
NOVA_DATA_DIR=data
NOVA_TEMP_DIR=/tmp/nova

# Feature Flags
NOVA_ENABLE_STREAMING=true
NOVA_ENABLE_CACHING=true
NOVA_ENABLE_RATE_LIMITING=true
NOVA_ENABLE_AUTO_SCALING=false
NOVA_ENABLE_COLLABORATIVE_MODE=true
NOVA_ENABLE_ADVANCED_MONITORING=true

# Rate Limiting
NOVA_RATE_LIMIT_REQUESTS=1000
NOVA_RATE_LIMIT_PERIOD=60

# Memory Management
NOVA_MAX_MEMORIES=1000
NOVA_MEMORY_TTL=86400
NOVA_CONSOLIDATION_THRESHOLD=100

# Model Configuration
NOVA_DEFAULT_MODEL=gpt-4o
NOVA_MAX_TOKENS=8192
NOVA_TEMPERATURE=0.7
