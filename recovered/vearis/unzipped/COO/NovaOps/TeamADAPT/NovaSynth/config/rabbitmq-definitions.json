{
    "rabbit_version": "3.12.0",
    "users": [
        {
            "name": "nova",
            "password_hash": "nova",
            "hashing_algorithm": "rabbit_password_hashing_sha256",
            "tags": ["administrator"]
        }
    ],
    "vhosts": [
        {
            "name": "/"
        }
    ],
    "permissions": [
        {
            "user": "nova",
            "vhost": "/",
            "configure": ".*",
            "write": ".*",
            "read": ".*"
        }
    ],
    "parameters": [],
    "policies": [],
    "queues": [
        {
            "name": "nova_framework_queue",
            "vhost": "/",
            "durable": true,
            "auto_delete": false,
            "arguments": {
                "x-queue-type": "classic",
                "x-max-length": 100000,
                "x-overflow": "reject-publish"
            }
        }
    ],
    "exchanges": [
        {
            "name": "nova_framework_exchange",
            "vhost": "/",
            "type": "topic",
            "durable": true,
            "auto_delete": false,
            "internal": false,
            "arguments": {}
        },
        {
            "name": "nova_dlx",
            "vhost": "/",
            "type": "topic",
            "durable": true,
            "auto_delete": false,
            "internal": false,
            "arguments": {}
        }
    ],
    "bindings": [
        {
            "source": "nova_framework_exchange",
            "vhost": "/",
            "destination": "nova_framework_queue",
            "destination_type": "queue",
            "routing_key": "#",
            "arguments": {}
        }
    ]
}
