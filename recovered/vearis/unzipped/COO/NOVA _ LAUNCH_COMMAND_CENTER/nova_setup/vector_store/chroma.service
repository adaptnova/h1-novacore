[Unit]
Description=ChromaDB Vector Database Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/xray/xx/nova_setup/vector_store
Environment=PYTHONPATH=/data/xray/xx/nova_setup
ExecStart=/usr/local/bin/python3 chroma_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target