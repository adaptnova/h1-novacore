    "vscodium-manager": {
      "command": "node",
      "args": [
        "/data-nova/ax/DevOps/DevOps-Codium/scripts/vscodium-manager.js"
      ],
      "env": {
        "VSCODIUM_BASE": "/home/x/.vscodium-isolated",
        "VSCODIUM_BINARY": "/data-nova/ax/DevOps/DevOps-VSC/NovaIDE/external/vscodium-bin/bin/codium",
        "SETTINGS_SOURCE": "/data-nova/ax/DevOps/DevOps-Codium/config/settings.json",
        "LOGS_DIR": "/data-nova/ax/DevOps/logs/vscodium",
        "DISPLAY": ":20",
        "XAUTHORITY": "/home/x/.Xauthority"
      },
      "disabled": false,
      "alwaysAllow": [
        "launch_instance",
        "update_settings",
        "manage_extensions",
        "monitor_health"
      ],
      "tools": {
        "launch_instance": {
          "description": "Launch a VSCodium instance for a Nova agent",
          "inputSchema": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string",
                "description": "Name of the Nova agent"
              },
              "workspace": {
                "type": "string",
                "description": "Path to workspace directory"
              }
            },
            "required": [
              "agent",
              "workspace"
            ]
          }
        },
        "update_settings": {
          "description": "Update settings for VSCodium instances",
          "inputSchema": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string",
                "description": "Name of the Nova agent (or 'all' for all instances)"
              },
              "settings": {
                "type": "object",
                "description": "Settings to update"
              }
            },
            "required": [
              "agent",
              "settings"
            ]
          }
        },
        "manage_extensions": {
          "description": "Manage VSCodium extensions",
          "inputSchema": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string",
                "description": "Name of the Nova agent"
              },
              "action": {
                "type": "string",
                "enum": [
                  "install",
                  "uninstall",
                  "update",
                  "list"
                ],
                "description": "Action to perform"
              },
              "extension": {
                "type": "string",
                "description": "Extension ID or path"
              }
            },
            "required": [
              "agent",
              "action"
            ]
          }
        },
        "monitor_health": {
          "description": "Monitor VSCodium instance health",
          "inputSchema": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string",
                "description": "Name of the Nova agent (or 'all' for all instances)"
              }
            },
            "required": [
              "agent"
            ]
          }
        }
      },
      "resources": {
        "instance_status": {
          "description": "Status of VSCodium instances",
          "uriTemplate": "vscodium://{agent}/status"
        },
        "settings_status": {
          "description": "Settings status for instances",
          "uriTemplate": "vscodium://{agent}/settings"
        },
        "extension_status": {
          "description": "Extension status for instances",
          "uriTemplate": "vscodium://{agent}/extensions"
        }
      }
    },
