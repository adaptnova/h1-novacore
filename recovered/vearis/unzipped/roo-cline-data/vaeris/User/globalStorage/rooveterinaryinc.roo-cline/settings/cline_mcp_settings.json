        "AUTH_PLUGIN": "org.apache.pulsar.client.impl.auth.AuthenticationToken",
        "AUTH_PARAMS": "token:eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJtY3AtZGV2b3BzIiwicm9sZSI6ImFkbWluIiwiaWF0IjoxNzA4Njg0MjYzLCJleHAiOjE3MTY0NjAyNjN9"
