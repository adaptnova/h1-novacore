ling Mini Agent package...${RESET}\"\n    47|    python3 -m pip install -e . --quiet\n    48|fi\n    49|\n    50|# Check configuration\n    51|CONFIG_FILE=\"/adaptai/projects/coders/m2/mini_agent/config/config.yaml\"\n    52|if [ ! -f \"$CONFIG_FILE\" ]; then\n    53|    echo -e \"${YELLOW}⚠️  Configuration file not found${RESET}\"\n    54|    echo -e \"${CYAN}Setting up configuration...${RESET}\"\n    55|    \n    56|    EXAMPLE_FILE=\"/adaptai/projects/coders/m2/mini_agent/config/config-example.yaml\"\n    57|    if [ -f \"$EXAMPLE_FILE\" ]; then\n    58|        cp \"$EXAMPLE_FILE\" \"$CONFIG_FILE\"\n    59|        echo -e \"${GREEN}✅ Configuration template copied${RESET}\"\n    60|        echo -e \"${CYAN}📝 Please edit $CONFIG_FILE and add your MiniMax API key${RESET}\"\n    61|        echo -e \"${CYAN}   Then run this script again${RESET}\"\n    62|        exit 0\n    63|    else\n    64|        echo -e \"${RED}❌ No configuration template found${RESET}\"\n    65|        exit 1\n    66|    fi\n    67|fi\n    68|\n    69|# Validate configuration\n    70|API_KEY=$(grep \"api_key:\" \"$CONFIG_FILE\" | sed 's/.*api_key: *//' | tr -d ' ')\n    71|if [ \"$API_KEY\" = \"YOUR_API_KEY_HERE\" ] || [ -z \"$API_KEY\" ]; then\n    72|    echo -e \"${RED}❌ API key not configured${RESET}\"\n    73|    echo -e \"${CYAN}Please edit $CONFIG_FILE and add your MiniMax API key${RESET}\"\n    74|    exit 1\n    75|fi\n    76|\n    77|echo -e \"${GREEN}✅ Configuration validated${RESET}\"\n    78|\n    79|# Handle command line arguments\n    80|if [ \"$1\" = \"--demo\" ]; then\n    81|    cd \"$SCRIPT_DIR\"\n    82|    exec python3 agent.py --demo\n    83|elif [ \"$1\" = \"--config\" ]; then\n    84|    echo -e \"${CYAN}📝 Configuration file location: $CONFIG_FILE${RESET}\"\n    85|    if command -v nano &> /dev/null; then\n    86|        read -p \"Would you like to edit the config file now? (y/N): \" -n 1 -r\n    87|        echo\n    88|        if [[ $REPLY =~ ^[Yy]$ ]]; then\n    89|            nano \"$CONFIG_FILE\"\n    90|        fi\n    91|    fi\n    92|    exit 0\n    93|elif [ \"$1\" = \"--help\" ] || [ \"$1\" = \"-h\" ]; then\n    94|    echo -e \"${BOLD}${CYAN}M2 Agent Launcher${RESET}\"\n    95|    echo \"\"\n    96|    echo \"Usage: ./launcher.sh [option]\"\n    97|    echo \"\"\n    98|    echo \"Options:\"\n    99|    echo \"  (no args)    Launch agent in interactive mode\"\n   100|    echo \"  --demo       Show agent capabilities and demo\"\n   101|    echo \"  --config     Edit configuration file\"\n   102|    echo \"  --help       Show this help message\"\n   103|    echo \"\"\n   104|    echo -e \"${GREEN}Agent Configuration:${RESET}\"\n   105|    echo -e \"  Name: ${AGENT_NAME}\"\n   106|    echo -e \"  Workspace: $SCRIPT_DIR/workspace\"\n   107|    echo -e \"  Memory: $SCRIPT_DIR/memory\"\n   108|    echo \"\"\n   109|    exit 0\n   110|fi\n   111|\n   112|# Launch agent\n   113|echo -e \"\\n${GREEN}🚀 Launching ${AGENT_NAME}...${RESET}\"\n   114|echo -e \"${BLUE}📁 Workspace: $SCRIPT_DIR/workspace${RESET}\"\n   115|echo -e \"${BLUE}🧠 Memory: $SCRIPT_DIR/memory${RESET}\"\n   116|echo -e \"${BOLD}${YELLOW}🔥 UNLIMITED MODE: 2,000,000 max steps${RESET}\\n\"\n   117|\n   118|# Change to agent directory and run\n   119|cd \"$SCRIPT_DIR\"\n   120|exec python3 agent.py \"$@\"",
