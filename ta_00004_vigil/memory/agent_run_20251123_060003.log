      "role": "tool",
      "content": "     1|#!/bin/bash\n     2|# SignalCore Deployment Script for DataOps Team\n     3|# 48-hour AI speed deployment for Phoenix integration\n     4|\n     5|set -e\n     6|\n     7|echo \"🚀 SIGNALCORE DEPLOYMENT - AI SPEED\"\n     8|echo \"====================================\"\n     9|echo \"Timeline: 48 hours to Phoenix integration\"\n    10|echo \"Owner: SignalCore Team\"\n    11|echo \"\"\n    12|\n    13|# Check if running as root (required for systemd service installation)\n    14|if [[ $EUID -eq 0 ]]; then\n    15|   echo \"✅ Running as root - proceeding with service installation\"\n    16|else\n    17|   echo \"⚠️  Not running as root - some operations may require sudo\"\n    18|   echo \"   Run with sudo for complete installation\"\n    19|fi\n    20|\n    21|# Create signalcore user and group\n    22|echo \"\"\n    23|echo \"1. Creating SignalCore system user...\"\n    24|if ! getent group signalcore >/dev/null 2>&1; then\n    25|    groupadd --system signalcore\n    26|    echo \"   ✅ Created signalcore group\"\n    27|else\n    28|    echo \"   ✅ signalcore group exists\"\n    29|fi\n    30|\n    31|if ! getent passwd signalcore >/dev/null 2>&1; then\n    32|    useradd --system --gid signalcore --home-dir /opt/signalcore --shell /bin/bash signalcore\n    33|    echo \"   ✅ Created signalcore user\"\n    34|else\n    35|    echo \"   ✅ signalcore user exists\"\n    36|fi\n    37|\n    38|# Create application directory\n    39|echo \"\"\n    40|echo \"2. Creating application directory...\"\n    41|mkdir -p /opt/signalcore\n    42|chown signalcore:signalcore /opt/signalcore\n    43|echo \"   ✅ Application directory ready\"\n    44|\n    45|# Install systemd services\n    46|echo \"\"\n    47|echo \"3. Installing SignalCore systemd services...\"\n    48|SERVICES_DIR=\"/adaptai/adapt/platform/signalcore/infrastructure/systemd\"\n    49|\n    50|for service in signalcore-memory signalcore-communication signalcore-cognitive signalcore-orchestrator; do\n    51|    if [[ -f \"$SERVICES_DIR/$service.service\" ]]; then\n    52|        cp \"$SERVICES_DIR/$service.service\" \"/etc/systemd/system/$service.service\"\n    53|        echo \"   ✅ Installed $service.service\"\n    54|    else\n    55|        echo \"   ❌ Missing $service.service\"\n    56|    fi\n    57|done\n    58|\n    59|# Reload systemd\n    60|echo \"\"\n    61|echo \"4. Reloading systemd configuration...\"\n    62|systemctl daemon-reload\n    63|echo \"   ✅ Systemd reloaded\"\n    64|\n    65|# Enable services (but don't start yet)\n    66|echo \"\"\n    67|echo \"5. Enabling SignalCore services...\"\n    68|for service in signalcore-memory signalcore-communication signalcore-cognitive signalcore-orchestrator; do\n    69|    systemctl enable \"$service\" 2>/dev/null || echo \"   ⚠️  Could not enable $service (may need manual start)\"\n    70|done\n    71|echo \"   ✅ Services enabled\"\n    72|\n    73|# Setup monitoring integration\n    74|echo \"\"\n    75|echo \"6. Setting up monitoring integration...\"\n    76|MONITORING_DIR=\"/adaptai/adapt/platform/signalcore/infrastructure/monitoring\"\n    77|\n    78|# Copy Prometheus configuration\n    79|if [[ -f \"$MONITORING_DIR/signalcore-prometheus.yml\" ]]; then\n    80|    cp \"$MONITORING_DIR/signalcore-prometheus.yml\" \"/etc/prometheus/signalcore.yml\" 2>/dev/null || echo \"   ⚠️  Could not install Prometheus config (may need manual setup)\"\n    81|    echo \"   ✅ Prometheus configuration ready\"\n    82|fi\n    83|\n    84|# Copy alerting rules\n    85|if [[ -f \"$MONITORING_DIR/signalcore_alerts.yml\" ]]; then\n    86|    cp \"$MONITORING_DIR/signalcore_alerts.yml\" \"/etc/prometheus/signalcore_alerts.yml\" 2>/dev/null || echo \"   ⚠️  Could not install alert rules (may need manual setup)\"\n    87|    echo \"   ✅ Alerting rules ready\"\n    88|fi\n    89|\n    90|# Create startup script\n    91|echo \"\"\n    92|echo \"7. Creating SignalCore startup script...\"\n    93|cat > /opt/signalcore/start-signalcore.sh << 'EOF'\n    94|#!/bin/bash\n    95|# SignalCore startup script for 48-hour Phoenix integration\n    96|\n    97|echo \"🚀 Starting SignalCore services for Phoenix integration...\"\n    98|\n    99|# Start services in dependency order\n   100|services=(\n   101|    \"signalcore-memory\"\n   102|    \"signalcore-communication\" \n   103|    \"signalcore-cognitive\"\n   104|    \"signalcore-orchestrator\"\n   105|)\n   106|\n   107|for service in \"${services[@]}\"; do\n   108|    echo \"Starting $service...\"\n   109|    systemctl start \"$service\"\n   110|    sleep 2\n   111|    if systemctl is-active --quiet \"$service\"; then\n   112|        echo \"✅ $service started successfully\"\n   113|    else\n   114|        echo \"❌ $service failed to start\"\n   115|        systemctl status \"$service\" --no-pager\n   116|    fi\n   117|done\n   118|\n   119|echo \"\"\n   120|echo \"SignalCore startup complete. Checking health...\"\n   121|sleep 5\n   122|\n   123|# Health check\n   124|if curl -f http://localhost:8000/health >/dev/null 2>&1; then\n   125|    echo \"✅ SignalCore orchestrator healthy\"\n   126|else\n   127|    echo \"❌ SignalCore orchestrator health check failed\"\n   128|fi\n   129|\n   130|echo \"\"\n   131|echo \"Phoenix integration services ready for SignalCore cognitive layer.\"\n   132|EOF\n   133|\n   134|chmod +x /opt/signalcore/start-signalcore.sh\n   135|chown signalcore:signalcore /opt/signalcore/start-signalcore.sh\n   136|echo \"   ✅ Startup script created\"\n   137|\n   138|# Create health check script\n   139|echo \"\"\n   140|echo \"8. Creating health check script...\"\n   141|cat > /opt/signalcore/health-check.sh << 'EOF'\n   142|#!/bin/bash\n   143|# SignalCore health check for DataOps team\n   144|\n   145|echo \"🔍 SIGNALCORE HEALTH CHECK\"\n   146|echo \"==========================\"\n   147|\n   148|# Check systemd services\n   149|echo \"Systemd Services:\"\n   150|services=(\"signalcore-memory\" \"signalcore-communication\" \"signalcore-cognitive\" \"signalcore-orchestrator\")\n   151|for service in \"${services[@]}\"; do\n   152|    if systemctl is-active --quiet \"$service\"; then\n   153|        echo \"  ✅ $service: ACTIVE\"\n   154|    else\n   155|        echo \"  ❌ $service: INACTIVE\"\n   156|        systemctl status \"$service\" --no-pager -l\n   157|    fi\n   158|done\n   159|\n   160|# Check database connections\n   161|echo \"\"\n   162|echo \"Database Connections:\"\n   163|databases=(\"DragonflyDB:18000\" \"Redis:18010\" \"MongoDB:18070\" \"ClickHouse:18090\" \"Qdrant:18050\" \"PostgreSQL:18030\")\n   164|for db in \"${databases[@]}\"; do\n   165|    IFS=':' read -r name port <<< \"$db\"\n   166|    if timeout 2 nc -z localhost \"$port\" >/dev/null 2>&1; then\n   167|        echo \"  ✅ $name ($port): ACCESSIBLE\"\n   168|    else\n   169|        echo \"  ❌ $name ($port): INACCESSIBLE\"\n   170|    fi\n   171|done\n   172|\n   173|# Check network endpoints\n   174|echo \"\"\n   175|echo \"Network Endpoints:\"\n   176|endpoints=(\"SignalCore Health:8000\" \"Memory Metrics:9091\" \"Communication Metrics:9092\" \"Cognitive Metrics:9093\")\n   177|for endpoint in \"${endpoints[@]}\"; do\n   178|    IFS=':' read -r name port <<< \"$endpoint\"\n   179|    if timeout 2 curl -f \"http://localhost:$port/health\" >/dev/null 2>&1; then\n   180|        echo \"  ✅ $name ($port): HEALTHY\"\n   181|    else\n   182|        echo \"  ⚠️  $name ($port): NOT RESPONDING (may not be started yet)\"\n   183|    fi\n   184|done\n   185|\n   186|echo \"\"\n   187|echo \"Health check complete.\"\n   188|EOF\n   189|\n   190|chmod +x /opt/signalcore/health-check.sh\n   191|chown signalcore:signalcore /opt/signalcore/health-check.sh\n   192|echo \"   ✅ Health check script created\"\n   193|\n   194|# Final status\n   195|echo \"\"\n   196|echo \"🎯 SIGNALCORE DEPLOYMENT SUMMARY\"\n   197|echo \"================================\"\n   198|echo \"\"\n   199|echo \"✅ System user created: signalcore\"\n   200|echo \"✅ Application directory: /opt/signalcore\"\n   201|echo \"✅ Systemd services: 4 installed and enabled\"\n   202|echo \"✅ Monitoring integration: Configured\"\n   203|echo \"✅ Startup script: /opt/signalcore/start-signalcore.sh\"\n   204|echo \"✅ Health check: /opt/signalcore/health-check.sh\"\n   205|echo \"\"\n   206|echo \"🚀 NEXT STEPS FOR 48-HOUR TIMELINE:\"\n   207|echo \"1. Run: /opt/signalcore/start-signalcore.sh\"\n   208|echo \"2. Monitor: /opt/signalcore/health-check.sh\"\n   209|echo \"3. Check logs: journalctl -u signalcore-*\"\n   210|echo \"4. Monitor: Prometheus/Grafana dashboards\"\n   211|echo \"\"\n   212|echo \"⚡ SIGNALCORE IS READY FOR PHOENIX INTEGRATION\"\n   213|echo \"   AI SPEED DEPLOYMENT COMPLETE\"\n   214|echo \"\"\n   215|echo \"DataOps: SignalCore cognitive intelligence layer is infrastructure-ready.\"\n   216|echo \"SignalCore: Owns 48-hour timeline success.\"\n   217|echo \"\"\n   218|echo \"Phoenix will be extraordinary.\"",
