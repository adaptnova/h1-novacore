      "role": "tool",
      "content": "     1|#!/bin/bash\n     2|# SignalCore Deployment Script for DataOps Team\n     3|# 48-hour AI speed deployment for Phoenix integration\n     4|\n     5|set -e\n     6|\n     7|echo \"🚀 SIGNALCORE DEPLOYMENT - AI SPEED\"\n     8|echo \"====================================\"\n     9|echo \"Timeline: 48 hours to Phoenix integration\"\n    10|echo \"Owner: SignalCore Team\"\n    11|echo \"\"\n    12|\n    13|# Check if running as root (required for systemd service installation)\n    14|if [[ $EUID -eq 0 ]]; then\n    15|   echo \"✅ Running as root - proceeding with service installation\"\n    16|else\n    17|   echo \"⚠️  Not running as root - some operations may require sudo\"\n    18|   echo \"   Run with sudo for complete installation\"\n    19|fi\n    20|\n    21|# Create signalcore user and group\n    22|echo \"\"\n    23|echo \"1. Creating SignalCore system user...\"\n    24|if ! getent group signalcore >/dev/null 2>&1; then\n    25|    groupadd --system signalcore\n    26|    echo \"   ✅ Created signalcore group\"\n    27|else\n    28|    echo \"   ✅ signalcore group exists\"\n    29|fi\n    30|\n    31|if ! getent passwd signalcore >/dev/null 2>&1; then\n    32|    useradd --system --gid signalcore --home-dir /opt/signalcore --shell /bin/bash signalcore\n    33|    echo \"   ✅ Created signalcore user\"\n    34|else\n    35|    echo \"   ✅ signalcore user exists\"\n    36|fi\n    37|\n    38|# Create application directory\n    39|echo \"\"\n    40|echo \"2. Creating application directory...\"\n    41|mkdir -p /opt/signalcore\n    42|chown signalcore:signalcore /opt/signalcore\n    43|echo \"   ✅ Application directory ready\"\n    44|\n    45|# Install systemd services\n    46|echo \"\"\n    47|echo \"3. Installing SignalCore systemd services...\"\n    48|SERVICES_DIR=\"/adaptai/adapt/platform/signalcore/infrastructure/systemd\"\n    49|\n    50|for service in signalcore-memory signalcore-communication signalcore-cognitive signalcore-orchestrator; do\n    51|    if [[ -f \"$SERVICES_DIR/$service.service\" ]]; then\n    52|        cp \"$SERVICES_DIR/$service.service\" \"/etc/systemd/system/$service.service\"\n    53|        echo \"   ✅ Installed $service.service\"\n    54|    else\n    55|        echo \"   ❌ Missing $service.service\"\n    56|    fi\n    57|done\n    58|\n    59|# Reload systemd\n    60|echo \"\"\n    61|echo \"4. Reloading systemd configuration...\"\n    62|systemctl daemon-reload\n    63|echo \"   ✅ Systemd reloaded\"\n    64|\n    65|# Enable services (but don't start yet)\n    66|echo \"\"\n    67|echo \"5. Enabling SignalCore services...\"\n    68|for service in signalcore-memory signalcore-communication signalcore-cognitive signalcore-orchestrator; do\n    69|    systemctl enable \"$service\" 2>/dev/null || echo \"   ⚠️  Could not enable $service (may need manual start)\"\n    70|done\n    71|echo \"   ✅ Services enabled\"\n    72|\n    73|# Setup monitoring integration\n    74|echo \"\"\n    75|echo \"6. Setting up monitoring integration...\"\n    76|MONITORING_DIR=\"/adaptai/adapt/platform/signalcore/infrastructure/monitoring\"\n    77|\n    78|# Copy Prometheus configuration\n    79|if [[ -f \"$MONITORING_DIR/signalcore-prometheus.yml\" ]]; then\n    80|    cp \"$MONITORING_DIR/signalcore-prometheus.yml\" \"/etc/prometheus/signalcore.yml\" 2>/dev/null || echo \"   ⚠️  Could not install Prometheus config (may need manual setup)\"\n    81|    echo \"   ✅ Prometheus configuration ready\"\n    82|fi\n    83|\n    84|# Copy alerting rules\n    85|if [[ -f \"$MONITORING_DIR/signalcore_alerts.yml\" ]]; then\n    86|    cp \"$MONITORING_DIR/signalcore_alerts.yml\" \"/etc/prometheus/signalcore_alerts.yml\" 2>/dev/null || echo \"   ⚠️  Could not install alert rules (may need manual setup)\"\n    87|    echo \"   ✅ Alerting rules ready\"\n    88|fi\n    89|\n    90|# Create startup script\n    91|echo \"\"\n    92|echo \"7. Creating SignalCore startup script...\"\n    93|cat > /opt/signalcor