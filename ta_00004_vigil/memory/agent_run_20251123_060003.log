n   173|ASYNC_MAX_CONNECTIONS=1000\n   174|ASYNC_TIMEOUT_SECONDS=30\n   175|\n   176|# =============================================================================\n   177|# MONITORING CONFIGURATION\n   178|# =============================================================================\n   179|\n   180|# Health Checks\n   181|HEALTH_CHECK_ENABLED=true\n   182|HEALTH_CHECK_INTERVAL_SECONDS=30\n   183|HEALTH_CHECK_TIMEOUT_SECONDS=5\n   184|\n   185|# Metrics Collection\n   186|METRICS_ENABLED=true\n   187|METRICS_PORT=9090\n   188|METRICS_COLLECTION_INTERVAL_SECONDS=10\n   189|\n   190|# Performance Monitoring\n   191|PERFORMANCE_MONITORING_ENABLED=true\n   192|PERFORMANCE_LOG_SLOW_QUERIES=true\n   193|PERFORMANCE_SLOW_QUERY_THRESHOLD_MS=1000\n   194|\n   195|# =============================================================================\n   196|# DEVELOPMENT SPECIFIC SETTINGS\n   197|# =============================================================================\n   198|\n   199|# Development Mode\n   200|DEVELOPMENT_MODE=true\n   201|DEBUG_MODE=true\n   202|VERBOSE_LOGGING=true\n   203|\n   204|# Test Data\n   205|LOAD_TEST_DATA=false\n   206|TEST_DATA_SIZE=100\n   207|CLEANUP_TEST_DATA_ON_STARTUP=true\n   208|\n   209|# Database Reset\n   210|RESET_DATABASES_ON_STARTUP=false\n   211|BACKUP_BEFORE_RESET=true\n   212|\n   213|# =============================================================================\n   214|# EXTERNAL INTEGRATIONS\n   215|# =============================================================================\n   216|\n   217|# Monitoring Stack\n   218|GRAFANA_ENABLED=true\n   219|GRAFANA_URL=http://localhost:18031\n   220|GRAFANA_USER=admin\n   221|GRAFANA_PASSWORD=admin\n   222|\n   223|PROMETHEUS_ENABLED=true\n   224|PROMETHEUS_URL=http://localhost:9090\n   225|\n   226|# Additional Services\n   227|MINIO_ENABLED=true\n   228|MINIO_API_PORT=18092\n   229|MINIO_CONSOLE_PORT=18093\n   230|MINIO_ACCESS_KEY=minioadmin\n   231|MINIO_SECRET_KEY=minioadmin\