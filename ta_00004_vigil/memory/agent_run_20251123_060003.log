      "role": "tool",
      "content": "     1|# SignalCore Development Configuration\n     2|# Copy this file to config/development/database.conf and update with your credentials\n     3|\n     4|# =============================================================================\n     5|# DATABASE CONFIGURATION\n     6|# =============================================================================\n     7|\n     8|# DragonflyDB (Primary Memory) - Port 18000-18002\n     9|DRAGONFLY_ENABLED=true\n    10|DRAGONFLY_HOST=localhost\n    11|DRAGONFLY_PORTS=18000,18001,18002\n    12|DRAGONFLY_PASSWORD=df_cluster_2024_adapt_research\n    13|DRAGONFLY_CLUSTER_MODE=true\n    14|DRAGONFLY_TTL_SECONDS=604800  # 7 days\n    15|\n    16|# Redis Cluster (Session Data) - Port 18010-18012  \n    17|REDIS_ENABLED=true\n    18|REDIS_HOST=localhost\n    19|REDIS_PORTS=18010,18011,18012\n    20|REDIS_PASSWORD=\n    21|REDIS_CLUSTER_MODE=true\n    22|REDIS_TTL_SECONDS=86400  # 24 hours\n    23|\n    24|# MongoDB (Document Storage) - Port 18070\n    25|MONGODB_ENABLED=true\n    26|MONGODB_HOST=localhost\n    27|MONGODB_PORT=18070\n    28|MONGODB_DATABASE=signalcore_dev\n    29|MONGODB_USER=admin\n    30|MONGODB_PASSWORD=changeme\n    31|MONGODB_AUTH_ENABLED=true\n    32|\n    33|# PostgreSQL (Structured Analytics) - Port 18030-18032\n    34|POSTGRESQL_ENABLED=true\n    35|POSTGRESQL_HOST=localhost\n    36|POSTGRESQL_PORTS=18030,18031,18032\n    37|POSTGRESQL_DATABASE=signalcore_dev\n    38|POSTGRESQL_USER=postgres_admin_user\n    39|POSTGRESQL_PASSWORD=changeme\n    40|POSTGRESQL_POOL_SIZE=10\n    41|POSTGRESQL_MAX_OVERFLOW=20\n    42|\n    43|# ClickHouse (Pattern Detection) - Port 18090\n    44|CLICKHOUSE_ENABLED=true\n    45|CLICKHOUSE_HOST=localhost\n    46|CLICKHOUSE_PORT=18090\n    47|CLICKHOUSE_DATABASE=signalcore_dev\n    48|CLICKHOUSE_USER=default\n    49|CLICKHOUSE_PASSWORD=\n    50|\n    51|# Qdrant (Vector Storage) - Port 18050\n    52|QDRANT_ENABLED=true\n    53|QDRANT_HOST=localhost\n    54|QDRANT_PO