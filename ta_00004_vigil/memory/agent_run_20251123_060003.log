RT=18050\n    55|QDRANT_COLLECTION=signalcore_vectors\n    56|QDRANT_VECTOR_SIZE=384\n    57|QDRANT_DISTANCE_METRIC=cosine\n    58|\n    59|# =============================================================================\n    60|# MESSAGE BROKER CONFIGURATION\n    61|# =============================================================================\n    62|\n    63|# NATS (Primary Message Broker) - Port 18020\n    64|NATS_ENABLED=true\n    65|NATS_HOST=localhost\n    66|NATS_PORT=18020\n    67|NATS_USER=admin\n    68|NATS_PASSWORD=teamadapt123\n    69|NATS_CLUSTER_ID=signalcore-cluster\n    70|\n    71|# RedPanda (Event Streaming) - Port 18020\n    72|REDPANDA_ENABLED=true\n    73|REDPANDA_HOST=localhost\n    74|REDPANDA_PORTS=18020,18021,18022\n    75|REDPANDA_BOOTSTRAP_SERVER=localhost:18020\n    76|\n    77|# =============================================================================\n    78|# COGNITIVE ENGINE CONFIGURATION\n    79|# =============================================================================\n    80|\n    81|# Learning System\n    82|LEARNING_ENABLED=true\n    83|LEARNING_BATCH_SIZE=100\n    84|LEARNING_LEARNING_RATE=0.001\n    85|LEARNING_MIN_CONFIDENCE=0.7\n    86|\n    87|# Pattern Recognition\n    88|PATTERN_RECOGNITION_ENABLED=true\n    89|PATTERN_MIN_FREQUENCY=5\n    90|PATTERN_CONFIDENCE_THRESHOLD=0.8\n    91|\n    92|# Decision Making\n    93|DECISION_ENGINE_ENABLED=true\n    94|DECISION_MAX_DEPTH=10\n    95|DECISION_TIMEOUT_SECONDS=5\n    96|\n    97|# =============================================================================\n    98|# API CONFIGURATION\n    99|# =============================================================================\n   100|\n   101|# REST API\n   102|API_ENABLED=true\n   103|API_HOST=localhost\n   104|API_PORT=8000\n   105|API_WORKERS=1\n   106|API_DEBUG=true\n   107|API_RELOAD=true\n   108|\n   109|# GraphQL API\n   110|GRAPHQL_ENABLED=true\n   111|GRAPHQL_ENDPOINT=/graphql\n   112|GRAPHQL_PLAYGROUND=true\n  