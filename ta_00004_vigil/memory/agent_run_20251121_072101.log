E_2_AUTH=\"${DRAGONFLY_PASSWORD:-df_cluster_2024_adapt_research}\"\n    36|DRAGONFLY_NODE_2_URL=\"redis://:${DRAGONFLY_NODE_2_AUTH}@localhost:${DRAGONFLY_NODE_2_PORT}\"\n    37|\n    38|DRAGONFLY_NODE_3_PORT=18002\n    39|DRAGONFLY_NODE_3_AUTH=\"${DRAGONFLY_PASSWORD:-df_cluster_2024_adapt_research}\"\n    40|DRAGONFLY_NODE_3_URL=\"redis://:${DRAGONFLY_NODE_3_AUTH}@localhost:${DRAGONFLY_NODE_3_PORT}\"\n    41|\n    42|DRAGONFLY_TEST_CMD=\"redis-cli -p 18000 -a '${DRAGONFLY_PASSWORD:-df_cluster_2024_adapt_research}' ping\"\n    43|\n    44|################################################################################\n    45|# 🔴 REDIS CLUSTER (Traditional Redis - Standalone Mode)\n    46|# Status: ✅ RUNNING - 3-node cluster operational\n    47|# Testing: redis-cli -p 18010 ping\n    48|################################################################################\n    49|REDIS_CLUSTER_ENABLED=true\n    50|REDIS_CLUSTER_MODE=\"cluster\"\n    51|REDIS_CLUSTER_PORTS=\"18010,18011,18012\"\n    52|REDIS_AUTH_TOKEN=\"${REDIS_PASSWORD:-changeme}\"\n    53|REDIS_STATUS=\"RUNNING\"\n    54|\n    55|# Redis Individual Nodes (Cluster Mode)\n    56|REDIS_NODE_1_PORT=18010\n    57|REDIS_NODE_1_AUTH=\"${REDIS_PASSWORD:-changeme}\"\n    58|REDIS_NODE_1_URL=\"redis://localhost:${REDIS_NODE_1_PORT}\"\n    59|\n    60|REDIS_NODE_2_PORT=18011\n    61|REDIS_NODE_2_AUTH=\"${REDIS_PASSWORD:-changeme}\"\n    62|REDIS_NODE_2_URL=\"redis://localhost:${REDIS_NODE_2_PORT}\"\n    63|\n    64|REDIS_NODE_3_PORT=18012\n    65|REDIS_NODE_3_AUTH=\"${REDIS_PASSWORD:-changeme}\"\n    66|REDIS_NODE_3_URL=\"redis://localhost:${REDIS_NODE_3_PORT}\"\n    67|\n    68|REDIS_CLUSTER_TEST_CMD=\"redis-cli -p 18010 ping\"\n    69|\n    70|################################################################################\n    71|# 🔄 REDPANDA CLUSTER (Kafka-compatible streaming platform)\n    72|# Status: ✅ RUNNING - Single node operational (dev mode)\n    73|# Testing: rpk cluster info --brokers 127.0.0.1:18020\n    74|################################################################################\n    75|REDPANDA_CLUSTER_ENABLED=true\n    76|REDPANDA_CLUSTER_PORTS=\"18020,18021,18022\"\n    77|REDPANDA_AUTH_TOKEN=\"${REDPANDA_AUTH_TOKEN:-changeme}\"\n    78|REDPANDA_STATUS=\"RUNNING\"\n    79|REDPANDA_VERSION=\"v25.2.9\"\n    80|\n    81|# RedPanda Individual Nodes\n    82|REDPANDA_NODE_1_PORT=18020\n    83|REDPANDA_NODE_1_ADMIN_PORT=18023\n    84|REDPANDA_NODE_1_RPC_PORT=18024\n    85|REDPANDA_NODE_1_URL=\"kafka://localhost:${REDPANDA_NODE_1_PORT}\"\n    86|\n    87|REDPANDA_NODE_2_PORT=18021\n    88|REDPANDA_NODE_2_ADMIN_PORT=18027\n    89|REDPANDA_NODE_2_RPC_PORT=18028\n    90|REDPANDA_NODE_2_URL=\"kafka://localhost:${REDPANDA_NODE_2_PORT}\"\n    91|\n    92|REDPANDA_NODE_3_PORT=18022\n    93|REDPANDA_NODE_3_ADMIN_PORT=18031\n    94|REDPANDA_NODE_3_RPC_PORT=18032\n    95|REDPANDA_NODE_3_URL=\"kafka://localhost:${REDPANDA_NODE_3_PORT}\"\n    96|\n    97|REDPANDA_CLUSTER_URLS=\"${REDPANDA_NODE_1_URL},${REDPANDA_NODE_2_URL},${REDPANDA_NODE_3_URL}\"\n    98|REDPANDA_TEST_CMD=\"rpk cluster info --brokers 127.0.0.1:18020\"\n    99|\n   100|################################################################################\n   101|# 🐘 POSTGRESQL + TIMESCALEDB (AI Data Platform)\n   102|# Status: ✅ RUNNING - Node 1 operational\n   103|# Testing: psql -h localhost -p 18030 -U postgres_admin_user -d teamadapt\n   104|################################################################################\n   105|POSTGRES_TIMESCALE_ENABLED=true\n   106|POSTGRES_TIMESCALE_AUTH_REQUIRED=true\n   107|POSTGRES_TIMESCALE_PORTS=\"18030,18031,18032\"\n   108|POSTGRES_TIMESCALE_STATUS=\"RUNNING\"\n   109|\n   110|# PostgreSQL Individual Nodes\n   111|POSTGRES_NODE_1_PORT=18030\n   112|POSTGRES_NODE_1_USER=\"postgres_admin_user\"\n   113|POSTGRES_NODE_1_AUTH=\"${POSTGRES_PASSWORD:-changeme}\"\n   114|POSTGRES_NODE_1_DB=\"teamadapt\"\n   115|POSTGRES_NODE_1_URL=\"postgresql://${POSTGRES_NODE_1_USER}:${POSTGRES_NODE_1_AUTH}@localhost:${POSTGRES_NODE_1_PORT}/${POSTGRES_NODE_1_DB}\"\n   116|\n   117|POSTGRES_NODE_2_PORT=18031\n   118|POSTGRES_NODE_2_USER=\"postgres_replica_user\"\n   119|POSTGRES_NODE_2_AUTH=\"${POSTGRES_REPLICA_PASSWORD:-changeme}\"\n   120|POSTGRES_NODE_2_DB=\"teamadapt_replica\"\n   121|POSTGRES_NODE_2_URL=\"postgresql://${POSTGRES_NODE_2_USER}:${POSTGRES_NODE_2_AUTH}@localhost:${POSTGRES_NODE_2_PORT}/${POSTGRES_NODE_2_DB}\"\n   122|\n   123|POSTGRES_NODE_3_PORT=18032\n   124|POSTGRES_NODE_3_USER=\"postgres_analytics_user\"\n   125|POSTGRES_NODE_3_AUTH=\"${POSTGRES_ANALYTICS_PASSWORD:-changeme}\"\n   126|POSTGRES_NODE_3_DB=\"teamadapt_analytics\"\n   127|POSTGRES_NODE_3_URL=\"postgresql://${POSTGRES_NODE_3_USER}:${POSTGRES_NODE_3_AUTH}@localhost:${POSTGRES_NODE_3_PORT}/${POSTGRES_NODE_3_DB}\"\n   128|\n   129|POSTGRES_CLUSTER_URLS=\"${POSTGRES_NODE_1_URL},${POSTGRES_NODE_2_URL},${POSTGRES_NODE_3_URL}\"\n   130|POSTGRES_TEST_CMD=\"psql -h localhost -p 18030 -U postgres_admin_user -d teamadapt -c 'SELECT version();'\"\n   131|\n   132|################################################################################\n   133|# 🍃 MONGODB (Document NoSQL Database)\n   134|# Status: ✅ RUNNING - Operational on port 18070\n   135|# Testing: mongosh --host localhost --port 18070\n   136|################################################################################\n   137|MONGODB_ENABLED=true\n   138|MONGODB_STATUS=\"RUNNING\"\n   139|MONGODB_VERSION=\"7.0.26\"\n   140|MONGODB_PORT=18070\n   141|MONGODB_BIND_IP=\"0.0.0.0\"\n   142|MONGODB_DATA_PATH=\"/var/lib/mongodb\"\n   143|MONGODB_LOG_PATH=\"/var/log/mongodb/mongod.log\"\n   144|\n   145|# MongoDB Connection Details\n   146|MONGODB_URL=\"mongodb://localhost:${MONGODB_PORT}\"\n   147|MONGODB_ADMIN_URL=\"mongodb://admin:changeme@localhost:${MONGODB_PORT}/admin\"\n   148|MONGODB_TEST_CMD=\"mongosh --host localhost --port ${MONGODB_PORT} --eval 'db.runCommand({ping: 1})'\"\n   149|\n   150|# Environment variables for MongoDB\n   151|MONGODB_DATABASE=\"${MONGODB_DATABASE:-teamadapt}\"\n   152|MONGODB_USER=\"${MONGODB_USER:-admin}\"\n   153|MONGODB_PASSWORD=\"${MONGODB_PASSWORD:-changeme}\"\n   154|\n   155|# Connection String with Auth\n   156|MONGODB_AUTH_URL=\"mongodb://${MONGODB_USER}:${MONGODB_PASSWORD}@localhost:${MONGODB_PORT}/${MONGODB_DATABASE}\"\n   157|\n   158|################################################################################\n   159|# 🕸️ NEO4J GRAPH DATABASE (Relationship Mapping)\n   160|# Status: ✅ RUNNING - Ports moved to 18xxx block (needs restart)\n   161|# Testing: curl -s -I http://localhost:18060\n   162|# NOTE: Neo4j configuration updated to use ports 18060 (HTTP) and 18061 (BOLT)\n   163|# Run: sudo -u neo4j neo4j restart to apply new port configuration\n   164|################################################################################\n   165|NEO4J_ENABLED=true\n   166|NEO4J_AUTH_REQUIRED=true\n   167|NEO4J_PORTS=\"18060,18061\"\n   168|NEO4J_STATUS=\"RUNNING (needs restart for port change)\"\n   169|\n   170|# Neo4j Connection Details\n   171|NEO4J_HTTP_PORT=18060\n   172|NEO4J_BOLT_PORT=18061\n   173|NEO4J_USER=\"neo4j\"\n   174|NEO4J_AUTH=\"${NEO4J_PASSWORD:-changeme}\"\n   175|NEO4J_HTTP_URL=\"http://${NEO4J_USER}:${NEO4J_AUTH}@localhost:${NEO4J_HTTP_PORT}\"\n   176|NEO4J_BOLT_URL=\"bolt://${NEO4J_USER}:${NEO4J_AUTH}@localhost:${NEO4J_BOLT_PORT}\"\n   177|NEO4J_TEST_CMD=\"curl -s -I http://localhost:${NEO4J_HTTP_PORT}\"\n   178|\n   179|################################################################################\n   180|# 🔮 QDRANT VECTOR DATABASE (Embeddings & Similarity Search)\n   181|# Status: ✅ RUNNING - Operational on port 18050\n   182|# Testing: netstat -tuln | grep 18050\n   183|################################################################################\n   184|QDRANT_ENABLED=true\n   185|QDRANT_AUTH_REQUIRED=false\n   186|QDRANT_PORTS=\"18050\"\n   187|QDRANT_STATUS=\"RUNNING\"\n   188|QDRANT_VERSION=\"1.16.0\"\n   189|\n   190|# Qdrant Connection Details\n   191|QDRANT_HTTP_PORT=18050\n   192|QDRANT_GRPC_PORT=6333\n   193|QDRANT_URL=\"http://localhost:${QDRANT_HTTP_PORT}\"\n   194|QDRANT_GRPC_URL=\"grpc://localhost:${QDRANT_GRPC_PORT}\"\n   195|QDRANT_TEST_CMD=\"curl -s http://localhost:${QDRANT_HTTP_PORT}/health\"\n   196|\n   197|# For embedding storage and similarity search\n   198|QDRANT_COLLECTION_DEFAULT=\"teamadapt_vectors\"\n   199|QDRANT_API_KEY=\"${VECTOR_API_KEY:-vector_api_key}\"\n   200|\n   201|################################################################################\n   202|# 📡 APACHE PULSAR (Event Streaming & Messaging - Memory Layer)\n   203|# Status: ✅ RUNNING - Operational on port 8080\n   204|# Testing: curl http://localhost:8080/admin/v2/brokers\n   205|################################################################################\n   206|PULSAR_ENABLED=true\n   207|PULSAR_STATUS=\"RUNNING\"\n   208|PULSAR_VERSION=\"3.3.0\"\n   209|PULSAR_BROKER_PORT=8080\n   210|PULSAR_BROKER_PORT_TLS=8443\n   211|PULSAR_BOOKIE_PORT=3181\n   212|\n   213|# Pulsar Connection Details\n   214|PULSAR_HTTP_URL=\"http://localhost:${PULSAR_BROKER_PORT}\"\n   215|PULSAR_ADMIN_URL=\"http://localhost:${PULSAR_BROKER_PORT}/admin/v2\"\n   216|PULSAR_TEST_CMD=\"curl -s http://localhost:${PULSAR_BROKER_PORT}/admin/v2/brokers\"\n   217|\n   218|# Pulsar Configuration\n   219|PULSAR_CLUSTER_NAME=\"teamadapt-cluster\"\n   220|PULSAR_DATA_DIR=\"/var/lib/pulsar/data\"\n   221|PULSAR_LOG_DIR=\"/var/lib/pulsar/logs\"\n   222|PULSAR_CONFIG_PATH=\"/opt/pulsar/conf/standalone.conf\"\n   223|\n   224|################################################################################\n   225|# 🔍 FAISS (Facebook AI Similarity Search)\n   226|# Status: ✅ INSTALLED - Python library ready\n   227|# Testing: python3 -c \"import faiss; print(faiss.__version__)\"\n   228|################################################################################\n   229|FAISS_ENABLED=true\n   230|FAISS_VERSION=\"1.12.0\"\n   231|FAISS_STATUS=\"INSTALLED\"\n   232|FAISS_INSTALL_PATH=\"/usr/local/lib/python3.*/site-packages/faiss\"\n   233|FAISS_TEST_CMD=\"python3 -c \\\"import faiss; print(f'FAISS version: {faiss.__version__}')\\\"\"\n   234|\n   235|################################################################################\n   236|# 📊 ELASTICSEARCH (Search and Analytics)\n   237|# Status: ✅ INSTALLED - Python client ready\n   238|# Testing: python3 -c \"import elasticsearch; print('Elasticsearch client installed')\"\n   239|################################################################################\n   240|ELASTICSEARCH_ENABLED=true\n   241|ELASTICSEARCH_STATUS=\"INSTALLED\"\n   242|ELASTICSEARCH_CLIENT_VERSION=\"8.x\"\n   243|ELASTICSEARCH_PYTHON_CLIENT=\"elasticsearch\"\n   244|ELASTICSEARCH_TEST_CMD=\"python3 -c \\\"import elasticsearch; print('Elasticsearch client installed')\\\"\"\n   245|\n   246|################################################################################\n   247|# 🚀 NATS (Cloud Native Messaging System)\n   248|# Status: ✅ RUNNING - Message broker and event streaming (MIGRATED TO SYSTEMD)\n   249|# Testing: nats-server --version\n   250|################################################################################\n   251|NATS_ENABLED=true\n   252|NATS_STATUS=\"RUNNING\"\n   253|NATS_VERSION=\"v2.10.18\"\n   254|NATS_PORT=18020\n   255|NATS_USER=\"admin\"\n   256|NATS_PASSWORD=\"teamadapt123\"\n   257|NATS_URL=\"nats://${NATS_USER}:${NATS_PASSWORD}@localhost:${NATS_PORT}\"\n   258|NATS_TEST_CMD=\"nats-server --version\"\n   259|\n   260|################################################################################\n   261|# ⚡ QUESTDB (Ultra-Fast Time-Series Database)\n   262|# Status: ✅ RUNNING - Docker container on port 18091\n   263|# Testing: curl http://localhost:18091/qp\n   264|################################################################################\n   265|QUESTDB_ENABLED=true\n   266|QUESTDB_STATUS=\"RUNNING\"\n   267|QUESTDB_VERSION=\"8.0.0\"\n   268|QUESTDB_PORT=18091\n   269|QUESTDB_ILP_PORT=9009\n   270|QUESTDB_HTTP_PORT=18091\n   271|QUESTDB_URL=\"http://localhost:${QUESTDB_PORT}\"\n   272|QUESTDB_TEST_CMD=\"curl -I http://localhost:${QUESTDB_PORT}/qp 2>&1 | head -1\"\n   273|\n   274|################################################################################\n   275|# 📊 CLICKHOUSE (Column-Oriented OLAP Database)\n   276|# Status: ✅ RUNNING - Service running on port 18090 (MIGRATED TO SYSTEMD)\n   277|# Testing: clickhouse-client --port 18090\n   278|################################################################################\n   279|CLICKHOUSE_ENABLED=true\n   280|CLICKHOUSE_STATUS=\"RUNNING\"\n   281|CLICKHOUSE_VERSION=\"18.16.1\"\n   282|CLICKHOUSE_NATIVE_PORT=9000\n   283|CLICKHOUSE_HTTP_PORT=18090\n   284|CLICKHOUSE_TCP_PORT=9000\n   285|CLICKHOUSE_URL=\"clickhouse://localhost:${CLICKHOUSE_TCP_PORT}\"\n   286|CLICKHOUSE_HTTP_URL=\"http://localhost:${CLICKHOUSE_HTTP_PORT}\"\n   287|CLICKHOUSE_TEST_CMD=\"clickhouse-client --port ${CLICKHOUSE_TCP_PORT} -q 'SELECT version()' 2>&1 | head -1\"\n   288|\n   289|################################################################################\n   290|# 📊 GRAFANA (Data Visualization & Monitoring)\n   291|# Status: ✅ RUNNING - Service running on port 18031 (MIGRATED TO SYSTEMD)\n   292|# Testing: curl http://localhost:18031/api/health\n   293|################################################################################\n   294|GRAFANA_ENABLED=true\n   295|GRAFANA_STATUS=\"RUNNING\"\n   296|GRAFANA_VERSION=\"latest\"\n   297|GRAFANA_PORT=18031\n   298|GRAFANA_USER=\"admin\"\n   299|GRAFANA_PASSWORD=\"admin\"\n   300|GRAFANA_URL=\"http://${GRAFANA_USER}:${GRAFANA_PASSWORD}@localhost:${GRAFANA_PORT}\"\n   301|GRAFANA_API_URL=\"http://localhost:${GRAFANA_PORT}/api\"\n   302|GRAFANA_TEST_CMD=\"curl -s ${GRAFANA_API_URL}/health | grep -o '\\\"database\\\":\\\"ok\\\"'\"\n   303|\n   304|################################################################################\n   305|# 📋 PGADMIN4 (PostgreSQL Administration Tool)\n   306|# Status: ⚠️ MIGRATION FAILED - Complex setup, recommend Docker\n   307|# Python package installed but database migration requires interactive setup\n   308|# Recommended: Use Docker container: docker run -p 18053:80 -e PGADMIN_DEFAULT_EMAIL=...\n   309|# Testing: Use Docker image: dpage/pgadmin4:latest\n   310|################################################################################\n   311|PGADMIN_ENABLED=false\n   312|PGADMIN_STATUS=\"FAILED\"\n   313|PGADMIN_PORT=18053\n   314|PGADMIN_USER=\"pgadmin@adapt.ai\"\n   315|PGADMIN_PASSWORD=\"admin\"\n   316|PGADMIN_URL=\"http://localhost:${PGADMIN_PORT}\"\n   317|PGADMIN_EMAIL=\"${PGADMIN_USER}\"\n   318|PGADMIN_CONFIG_FILE=\"/var/lib/pgadmin/config.py\"\n   319|PGADMIN_TEST_CMD=\"curl -s http://localhost:${PGADMIN_PORT} -o /dev/null; echo $?\"\n   320|PGADMIN_DOCKER_CMD=\"docker run -d --name pgadmin4 -p 18053:80 -e PGADMIN_DEFAULT_EMAIL=pgadmin@adapt.ai -e PGADMIN_DEFAULT_PASSWORD=admin dpage/pgadmin4:latest\"\n   321|\n   322|################################################################################\n   323|# ⚡ MATERIALIZE (Streaming SQL Database)\n   324|# Status: ✅ INSTALLED - CLI v0.3.0 (Cloud/Managed)\n   325|# Installation: Official APT repository\n   326|# Note: CLI for Materialize Cloud & self-managed deployments\n   327|################################################################################\n   328|MATERIALIZE_ENABLED=true\n   329|MATERIALIZE_STATUS=\"INSTALLED_CLI\"\n   330|MATERIALIZE_VERSION=\"0.3.0\"\n   331|MATERIALIZE_INSTALL_METHOD=\"APT repository\"\n   332|MATERIALIZE_URL=\"https://materialize.com\"\n   333|MATERIALIZE_TEST_CMD=\"mz --version\"\n   334|\n   335|################################################################################\n   336|# CLUSTER MANAGEMENT URLS\n   337|#######################################################################