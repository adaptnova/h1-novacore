      "content": "     1|#!/bin/bash\n     2|################################################################################\n     3|# TeamADAPT DBOps - Prisma Schema Management\n     4|# Owned and managed by DBOps Team\n     5|# Purpose: Controlled database schema changes for TeamADAPT services\n     6|################################################################################\n     7|\n     8|set -e\n     9|\n    10|SCHEMA_DIR=\"/adaptai/dbops/prisma\"\n    11|cd \"$SCHEMA_DIR\"\n    12|\n    13|echo \"==========================================\"\n    14|echo \"🔧 TeamADAPT Prisma Schema Management\"\n    15|echo \"==========================================\"\n    16|echo \"\"\n    17|\n    18|# Function to display help\n    19|show_help() {\n    20|    echo \"Usage: ./manage.sh [command]\"\n    21|    echo \"\"\n    22|    echo \"Commands:\"\n    23|    echo \"  generate    Generate Prisma Client\"\n    24|    echo \"  migrate     Create new migration\"\n    25|    echo \"  deploy      Deploy migrations to production\"\n    26|    echo \"  pull        Pull database schema (introspection)\"\n    27|    echo \"  status      Show migration status\"\n    28|    echo \"  reset       Reset development database (DESTRUCTIVE)\"\n    29|    echo \"\"\n    30|    echo \"Environment:\"\n    31|    echo \"  DATABASE_URL=${DATABASE_URL}\"\n    32|    echo \"\"\n    33|}\n    34|\n    35|# Generate Prisma Client\n    36|generate() {\n    37|    echo \"🔄 Generating Prisma Client...\"\n    38|    npx prisma generate\n    39|    echo \"✅ Prisma Client generated\"\n    40|}\n    41|\n    42|# Create new migration\n    43|create_migration() {\n    44|    if [ -z \"$1\" ]; then\n    45|        echo \"❌ Error: Migration name required\"\n    46|        echo \"   Usage: ./manage.sh migrate your_change_name\"\n    47|        exit 1\n    48|    fi\n    49|    \n    50|    echo \"🔄 Creating migration: $1\"\n    51|    npx prisma migrate dev --name \"$1\"\n    52|    echo \"✅ Migration created\"\n    53|    echo \"\"\n    54|    echo \"📋 Next steps:\"\n    55|    echo \"   1. Review migration in ./prisma/migrations/\"\n    56|    echo \"   2. Run './manage.sh deploy' to apply to production\"\n    57|}\n    58|\n    59|# Deploy migrations\n    60|deploy() {\n    61|    echo \"🚀 Deploying migrations to production...\"\n    62|    npx prisma migrate deploy\n    63|    echo \"✅ Migrations deployed\"\n    64|}\n    65|\n    66|# Pull database schema\n    67|pull() {\n    68|    echo \"🔄 Introspecting database schema...\"\n    69|    npx prisma db pull\n    70|    echo \"✅ Schema updated from database\"\n    71|    echo \"\"\n    72|    echo \"📋 Next steps:\"\n    73|    echo \"   1. Review changes in schema.prisma\"\n    74|    echo \"   2. Run './manage.sh generate' to update client\"\n    75|}\n    76|\n    77|# Show status\n    78|status() {\n    79|    echo \"📊 Migration Status:\"\n    80|    npx prisma migrate status\n    81|}\n    82|\n    83|# Reset database (dev only)\n    84|reset() {\n    85|    echo \"⚠️  WARNING: This will reset the development database!\"\n    86|    echo \"   All data will be lost.\"\n    87|    echo \"\"\n    88|    read -p \"Type 'RESET' to confirm: \" confirm\n    89|    \n    90|    if [ \"$confirm\" = \"RESET\" ]; then\n    91|        echo \"🔄 Resetting database...\"\n    92|        npx prisma migrate reset --force\n    93|        echo \"✅ Database reset\"\n    94|    else\n    95|        echo \"❌ Reset cancelled\"\n    96|    fi\n    97|}\n    98|\n    99|# Main command handler\n   100|case \"$1\" in\n   101|    generate)\n   102|        generate\n   103|        ;;\n   104|    migrate)\n   105|        create_migration \"$2\"\n   106|        ;;\n   107|    deploy)\n   108|        deploy\n   109|        ;;\n   110|    pull)\n   111|        pull\n   112|        ;;\n   113|    status)\n   114|        status\n   115|        ;;\n   116|    reset)\n   117|        reset\n   118|        ;;\n   119|    help|--help|-h)\n   120|        show_help\n   121|        ;;\n   122|    *)\n   123|        show_help\n   124|        exit 1\n   125|        ;;\n   126|esac\n   127|\n   128|echo \"\"\n   129|echo \"==========================================\"\n   130|echo \"Done! 🎉\"\n   131|echo \"==========================================\"",
