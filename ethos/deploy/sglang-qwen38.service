[Unit]
Description=SGLang Qwen3.8-Flash-Next-NVFP4 (Pennyroyal) OpenAI-compatible endpoint
Documentation=https://github.com/jpezzulli/sglang-rtxpro6000
After=network.target
Wants=network.target

[Service]
Type=simple
User=x
Group=x
WorkingDirectory=/home/x
Environment=PYTHONUNBUFFERED=1
# Runtime env (build-time compiler env is not needed here; only JIT/runtime vars)
Environment=CUDA_HOME=/usr/local/cuda
Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64
Environment=CUDA_VISIBLE_DEVICES=0
Environment=HF_HOME=/home/x/sglang-cache/huggingface
Environment=TORCHINDUCTOR_CACHE_DIR=/home/x/sglang-cache/torchinductor
Environment=TRITON_CACHE_DIR=/home/x/sglang-cache/triton
Environment=CUDA_CACHE_PATH=/home/x/sglang-cache/cuda
Environment=SGLANG_CACHE_DIR=/home/x/sglang-cache/sglang
Environment=SGLANG_JIT_CACHE_DIR=/home/x/sglang-cache/sglang/jit
Environment=SGLANG_NUMA_BIND_V2=false
Environment=SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1
Environment=SGLANG_MAMBA_CONV_DTYPE=bfloat16
Environment=TORCH_CUDA_ARCH_LIST=12.0
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=/home/x/deploy/pennyroyal-prod.sh
Restart=on-failure
RestartSec=10
LimitNOFILE=1048576
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pennyroyal

[Install]
WantedBy=multi-user.target
